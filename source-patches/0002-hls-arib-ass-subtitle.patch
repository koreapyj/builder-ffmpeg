+/* Write the ARIB ASS header once to the init segment (EXT-X-MAP target). */
+static int hls_write_ass_init(AVFormatContext *s, VariantStream *vs)
+{
+    HLSContext *hls = s->priv_data;
+    AVDictionary *options = NULL;
+    AVIOContext *pb = NULL;
+    int ret;
+
+    if (!vs->ass_init_filename || !vs->ass_header || vs->ass_header_size <= 0)
+        return 0;
+    set_http_options(s, &options, hls);
+    ret = hlsenc_io_open(s, &pb, vs->ass_init_filename, &options);
+    av_dict_free(&options);
+    if (ret < 0)
+        return hls->ignore_io_errors ? 0 : ret;
+    /* init.ass holds [Script Info]+[V4+ Styles] only; each segment writes its own
+     * [Events]+Format (assenc section_header), so drop everything from [Events] on. */
+    {
+        const uint8_t *ev = vs->ass_header;
+        int n = vs->ass_header_size;
+        const char *q = strstr((const char *)vs->ass_header, "[Events]");
+        if (q)
+            n = (int)((const uint8_t *)q - vs->ass_header);
+        avio_write(pb, ev, n);
+    }
+    hlsenc_io_close(s, &pb, vs->ass_init_filename);
+    return 0;
+}
