+ * order-dependent suffix. A flat layout that needs disambiguation can put %v in the name. */
+static int set_ass_init_filename(AVFormatContext *s, VariantStream *vs,
+                                 char *playlist, int i)
+{
+    HLSContext *hls = s->priv_data;
+    char *name = NULL, *p;
+    int ret;
+
+    if (av_stristr(hls->ass_init_filename, "%v")) {
+        if ((ret = format_name(hls->ass_init_filename, &name, i, vs->varname)) < 0)
+            return ret;
