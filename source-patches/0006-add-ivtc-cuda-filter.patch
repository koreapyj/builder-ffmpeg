+/*
+ * vf_ivtc_cuda -- hardware inverse telecine (field-matching) through CUDA.
+ *
+ * The CUDA backend of the shared ivtc core (ivtc_common.c), the counterpart
+ * of ivtc_opencl for the zero-copy NVDEC -> CUDA -> NVENC chain:
+ *   -hwaccel cuda -hwaccel_output_format cuda ... -vf ivtc_cuda -c:v h264_nvenc
+ *
+ * All GPU work is issued on the device's stream; the only syncs are the one
+ * readback per frame (match accumulators) and one per 5-frame cycle
+ * (decimation diffs). The matched frame is woven with pitched 2D copies.
+ */
+
+#include "libavutil/avassert.h"
+#include "libavutil/buffer.h"
+#include "libavutil/common.h"
+#include "libavutil/cuda_check.h"
+#include "libavutil/hwcontext.h"
+#include "libavutil/hwcontext_cuda_internal.h"
+#include "libavutil/imgutils.h"
+#include "libavutil/mem.h"
+#include "libavutil/opt.h"
+#include "libavutil/pixdesc.h"
+
+#include "avfilter.h"
+#include "filters.h"
+#include "ivtc.h"
+#include "video.h"
+
+#include "cuda/load_helper.h"
+
+extern const unsigned char ff_vf_ivtc_cuda_ptx_data[];
+extern const unsigned int ff_vf_ivtc_cuda_ptx_len;
+
+static const enum AVPixelFormat supported_formats[] = {
+    AV_PIX_FMT_NV12,
+    AV_PIX_FMT_YUV420P,
+    AV_PIX_FMT_P010,
+    AV_PIX_FMT_P016,
+    AV_PIX_FMT_YUV444P,
+    AV_PIX_FMT_YUV444P16,
+};
+
+typedef struct IvtcCUDAContext {
+    IVTCContext ivtc;
+
+    AVCUDADeviceContext *hwctx;
+    AVBufferRef         *device_ref;
+    AVBufferRef         *input_frames_ref;
+    AVHWFramesContext   *input_frames;
+
+    int         pixel_size;       // bytes per luma sample (1 or 2)
+    float       scale_fm;         // raw luma -> 0..255 (fieldmatch units)
+    float       scale_diff;       // raw luma -> 0..1   (decimation units)
+    int         nb_planes;
+    int         plane_bytes[4];   // bytes per row of each plane
+    int         plane_h[4];
+
+    CUmodule    cu_module;
+    CUfunction  cu_absdiff;       // fm_absdiff_{uchar,ushort}
+    CUfunction  cu_diffmap;       // fm_diffmap
+    CUfunction  cu_compare;       // fm_compare_accum_{uchar,ushort}
+    CUfunction  cu_diff;          // ivtc_diff_{uchar,ushort}
+
+    CUdeviceptr absdiff_buf;      // |cur-cand| per borrowed field row (w*hf uchar)
+    CUdeviceptr flag_buf;         // build_diff_map flags (w*hf uchar)
+    CUdeviceptr cmp_buf;          // per-block compare_fields partials (nwg*6 float)
+    CUdeviceptr diff_buf;         // per-block luma SAD (IVTC_CYCLE slices of nwg float)
+    float      *cmp_host;
+    float      *diff_host;
+} IvtcCUDAContext;
+
+#define DIV_UP(a, b) ( ((a) + (b) - 1) / (b) )
+#define CHECK_CU(x) FF_CUDA_CHECK_DL(avctx, ctx->hwctx->internal->cuda_dl, x)
+
+// ---- helpers --------------------------------------------------------------
+
+static int ivtc_cuda_launch(AVFilterContext *avctx, CUfunction func,
+                            int grid_x, int grid_y, void **args)
+{
+    IvtcCUDAContext *ctx = avctx->priv;
+    CudaFunctions *cu = ctx->hwctx->internal->cuda_dl;
+    return CHECK_CU(cu->cuLaunchKernel(func, grid_x, grid_y, 1,
+                                       IVTC_WG, IVTC_WG, 1,
+                                       0, ctx->hwctx->stream, args, NULL));
+}
+
+// Device -> host copy on the filter stream, then wait for the stream: the
+// stream is in order, so all earlier work (incl. prior synths) is done too.
+static int ivtc_cuda_readback(AVFilterContext *avctx, void *dst, CUdeviceptr src,
+                              size_t row_bytes, int rows)
+{
+    IvtcCUDAContext *ctx = avctx->priv;
+    CudaFunctions *cu = ctx->hwctx->internal->cuda_dl;
+    CUDA_MEMCPY2D cpy = {
+        .srcMemoryType = CU_MEMORYTYPE_DEVICE,
+        .srcDevice     = src,
+        .srcPitch      = row_bytes,
+        .dstMemoryType = CU_MEMORYTYPE_HOST,
+        .dstHost       = dst,
+        .dstPitch      = row_bytes,
+        .WidthInBytes  = row_bytes,
+        .Height        = rows,
+    };
+    int ret = CHECK_CU(cu->cuMemcpy2DAsync(&cpy, ctx->hwctx->stream));
+    if (ret < 0)
+        return ret;
+    return CHECK_CU(cu->cuStreamSynchronize(ctx->hwctx->stream));
+}
+
+static void ivtc_cuda_sync(AVFilterContext *avctx)
+{
+    IvtcCUDAContext *ctx = avctx->priv;
+    CudaFunctions *cu;
+    CUcontext dummy;
+
+    if (!ctx->hwctx)
+        return;
+    cu = ctx->hwctx->internal->cuda_dl;
+    if (CHECK_CU(cu->cuCtxPushCurrent(ctx->hwctx->cuda_ctx)) < 0)
+        return;
+    CHECK_CU(cu->cuStreamSynchronize(ctx->hwctx->stream));
+    CHECK_CU(cu->cuCtxPopCurrent(&dummy));
+}
+
+// ---- one-time GPU init (module, kernels, score/diff buffers) --------------
+
+static int ivtc_init_cuda(AVFilterContext *avctx)
+{
+    IvtcCUDAContext *ctx = avctx->priv;
+    IVTCContext *s = &ctx->ivtc;
+    CudaFunctions *cu = ctx->hwctx->internal->cuda_dl;
+    const char *sfx = ctx->pixel_size == 1 ? "uchar" : "ushort";
+    size_t field_bytes = (size_t)s->luma_w * s->luma_hf;
+    char name[64];
+    CUcontext dummy;
+    int ret;
+
+    ret = CHECK_CU(cu->cuCtxPushCurrent(ctx->hwctx->cuda_ctx));
+    if (ret < 0)
+        return ret;
+
+    ret = ff_cuda_load_module(avctx, ctx->hwctx, &ctx->cu_module,
+                              ff_vf_ivtc_cuda_ptx_data, ff_vf_ivtc_cuda_ptx_len);
+    if (ret < 0)
+        goto exit;
+
+    snprintf(name, sizeof(name), "fm_absdiff_%s", sfx);
+    if ((ret = CHECK_CU(cu->cuModuleGetFunction(&ctx->cu_absdiff, ctx->cu_module, name))) < 0)
+        goto exit;
+    if ((ret = CHECK_CU(cu->cuModuleGetFunction(&ctx->cu_diffmap, ctx->cu_module, "fm_diffmap"))) < 0)
+        goto exit;
+    snprintf(name, sizeof(name), "fm_compare_accum_%s", sfx);
+    if ((ret = CHECK_CU(cu->cuModuleGetFunction(&ctx->cu_compare, ctx->cu_module, name))) < 0)
+        goto exit;
+    snprintf(name, sizeof(name), "ivtc_diff_%s", sfx);
+    if ((ret = CHECK_CU(cu->cuModuleGetFunction(&ctx->cu_diff, ctx->cu_module, name))) < 0)
+        goto exit;
+
+    if ((ret = CHECK_CU(cu->cuMemAlloc(&ctx->absdiff_buf, FFMAX(field_bytes, 1)))) < 0 ||
+        (ret = CHECK_CU(cu->cuMemAlloc(&ctx->flag_buf, FFMAX(field_bytes, 1)))) < 0 ||
+        (ret = CHECK_CU(cu->cuMemAlloc(&ctx->cmp_buf, (size_t)s->nwg * 6 * sizeof(float)))) < 0 ||
+        (ret = CHECK_CU(cu->cuMemAlloc(&ctx->diff_buf, (size_t)s->nwg * IVTC_CYCLE * sizeof(float)))) < 0)
+        goto exit;
+
+    ctx->cmp_host  = av_malloc_array(s->nwg, 6 * sizeof(float));
+    ctx->diff_host = av_calloc((size_t)s->nwg * IVTC_CYCLE, sizeof(float));
+    if (!ctx->cmp_host || !ctx->diff_host)
+        ret = AVERROR(ENOMEM);
+
+exit:
+    CHECK_CU(cu->cuCtxPopCurrent(&dummy));
+    return ret;
+}
+
+// ---- GPU hooks ------------------------------------------------------------
+
+// compare_fields accumulators (C vs P) in three chained kernels, then one
+// blocking readback of the per-block partials, summed here.
+static int ivtc_cuda_match_accum(AVFilterContext *avctx, AVFrame *prevf, AVFrame *curf,
+                                 AVFrame *nextf, int tff, double A[3], double B[3])
+{
+    IvtcCUDAContext *ctx = avctx->priv;
+    IVTCContext *s = &ctx->ivtc;
+    CudaFunctions *cu = ctx->hwctx->internal->cuda_dl;
+    CUdeviceptr cur  = (CUdeviceptr)curf->data[0];
+    CUdeviceptr cand = (CUdeviceptr)prevf->data[0];
+    int cur_pitch  = curf->linesize[0]  / ctx->pixel_size;
+    int cand_pitch = prevf->linesize[0] / ctx->pixel_size;
+    int w = s->luma_w, h = s->luma_h, hf = s->luma_hf, nbx = s->nwgx;
+    CUcontext dummy;
+    int ret, i;
+
+    void *args_absdiff[] = { &cur, &cand, &cur_pitch, &cand_pitch, &w, &h, &hf,
+                             &tff, &ctx->scale_fm, &ctx->absdiff_buf };
+    void *args_diffmap[] = { &ctx->absdiff_buf, &w, &hf, &ctx->flag_buf };
+    void *args_compare[] = { &cur, &cand, &cur_pitch, &cand_pitch, &w, &h, &tff,
+                             &ctx->flag_buf, &hf, &ctx->scale_fm, &nbx, &ctx->cmp_buf };
+
+    (void)nextf;
+
+    ret = CHECK_CU(cu->cuCtxPushCurrent(ctx->hwctx->cuda_ctx));
+    if (ret < 0)
+        return ret;
+
+    if (hf > 0) {
+        if ((ret = ivtc_cuda_launch(avctx, ctx->cu_absdiff, DIV_UP(w, IVTC_WG),
+                                    DIV_UP(hf, IVTC_WG), args_absdiff)) < 0 ||
+            (ret = ivtc_cuda_launch(avctx, ctx->cu_diffmap, DIV_UP(w, IVTC_WG),
+                                    DIV_UP(hf, IVTC_WG), args_diffmap)) < 0)
+            goto exit;
+    }
+    if ((ret = ivtc_cuda_launch(avctx, ctx->cu_compare, s->nwgx, s->nwgy, args_compare)) < 0 ||
+        (ret = ivtc_cuda_readback(avctx, ctx->cmp_host, ctx->cmp_buf,
+                                  (size_t)s->nwg * 6 * sizeof(float), 1)) < 0)
+        goto exit;
+
+    for (i = 0; i < s->nwg; i++) {
+        A[0] += ctx->cmp_host[i*6+0]; A[1] += ctx->cmp_host[i*6+1]; A[2] += ctx->cmp_host[i*6+2];
+        B[0] += ctx->cmp_host[i*6+3]; B[1] += ctx->cmp_host[i*6+4]; B[2] += ctx->cmp_host[i*6+5];
+    }
+
+exit:
+    CHECK_CU(cu->cuCtxPopCurrent(&dummy));
+    return ret;
+}
+
+// Copy the rows of one parity (0 = even, 1 = odd) of plane p from src to dst.
+static int ivtc_cuda_copy_field(AVFilterContext *avctx, AVFrame *dst, AVFrame *src,
+                                int p, int parity)
+{
+    IvtcCUDAContext *ctx = avctx->priv;
+    CudaFunctions *cu = ctx->hwctx->internal->cuda_dl;
+    int rows = (ctx->plane_h[p] - parity + 1) / 2;
+    CUDA_MEMCPY2D cpy = {
+        .srcMemoryType = CU_MEMORYTYPE_DEVICE,
+        .srcDevice     = (CUdeviceptr)src->data[p] + (size_t)parity * src->linesize[p],
+        .srcPitch      = 2 * src->linesize[p],
+        .dstMemoryType = CU_MEMORYTYPE_DEVICE,
+        .dstDevice     = (CUdeviceptr)dst->data[p] + (size_t)parity * dst->linesize[p],
+        .dstPitch      = 2 * dst->linesize[p],
+        .WidthInBytes  = ctx->plane_bytes[p],
+        .Height        = rows,
+    };
+    if (rows <= 0)
+        return 0;
+    return CHECK_CU(cu->cuMemcpy2DAsync(&cpy, ctx->hwctx->stream));
+}
+
+// Weave the chosen match into dst (all planes), candidate geometry as in
+// opencl/ivtc.cl: C keeps cur; P/N keep cur's first field and borrow the
+// second from prev/next; B/U keep cur's second field and borrow the first.
+static int ivtc_cuda_synth(AVFilterContext *avctx, AVFrame *dst, AVFrame *prev,
+                           AVFrame *cur, AVFrame *next, int tff, int match)
+{
+    IvtcCUDAContext *ctx = avctx->priv;
+    CudaFunctions *cu = ctx->hwctx->internal->cuda_dl;
+    int first = tff ? 0 : 1;   // parity of the first (top) field rows
+    AVFrame *src_first, *src_second;
+    CUcontext dummy;
+    int ret, p;
+
+    switch (match) {
+    case 1:  src_first = cur;  src_second = prev; break; // P
+    case 2:  src_first = cur;  src_second = next; break; // N
+    case 3:  src_first = prev; src_second = cur;  break; // B
+    case 4:  src_first = next; src_second = cur;  break; // U
+    default: src_first = cur;  src_second = cur;  break; // C
+    }
+
+    ret = CHECK_CU(cu->cuCtxPushCurrent(ctx->hwctx->cuda_ctx));
+    if (ret < 0)
+        return ret;
+    for (p = 0; p < ctx->nb_planes; p++) {
+        if ((ret = ivtc_cuda_copy_field(avctx, dst, src_first,  p, first)) < 0 ||
+            (ret = ivtc_cuda_copy_field(avctx, dst, src_second, p, !first)) < 0)
+            break;
+    }
+    CHECK_CU(cu->cuCtxPopCurrent(&dummy));
+    return ret;
+}
+
+// ivtc_diff emits one abs-diff sum per 16x16 block into its slice; all
+// launches are enqueued first, then ONE blocking read of the whole buffer.
+static int ivtc_cuda_diff_cycle(AVFilterContext *avctx, AVFrame *const a[IVTC_CYCLE],
+                                AVFrame *const b[IVTC_CYCLE], const float **sums, int *stride)
+{
+    IvtcCUDAContext *ctx = avctx->priv;
+    IVTCContext *s = &ctx->ivtc;
+    CudaFunctions *cu = ctx->hwctx->internal->cuda_dl;
+    int w = s->luma_w, h = s->luma_h, nbx = s->nwgx;
+    CUcontext dummy;
+    int ret, i;
+
+    ret = CHECK_CU(cu->cuCtxPushCurrent(ctx->hwctx->cuda_ctx));
+    if (ret < 0)
+        return ret;
+
+    for (i = 0; i < IVTC_CYCLE; i++) {
+        CUdeviceptr pa, pb, out;
+        int a_pitch, b_pitch;
+        void *args[] = { &pa, &pb, &a_pitch, &b_pitch, &w, &h,
+                         &ctx->scale_diff, &nbx, &out };
+        if (!b[i])
+            continue;
+        pa = (CUdeviceptr)a[i]->data[0];
+        pb = (CUdeviceptr)b[i]->data[0];
+        a_pitch = a[i]->linesize[0] / ctx->pixel_size;
+        b_pitch = b[i]->linesize[0] / ctx->pixel_size;
+        out = ctx->diff_buf + (size_t)i * s->nwg * sizeof(float);
+        if ((ret = ivtc_cuda_launch(avctx, ctx->cu_diff, s->nwgx, s->nwgy, args)) < 0)
+            goto exit;
+    }
+    ret = ivtc_cuda_readback(avctx, ctx->diff_host, ctx->diff_buf,
+                             (size_t)s->nwg * sizeof(float), IVTC_CYCLE);
+    if (ret < 0)
+        goto exit;
+
+    *sums   = ctx->diff_host;
+    *stride = s->nwg;
+
+exit:
+    CHECK_CU(cu->cuCtxPopCurrent(&dummy));
+    return ret;
+}
+
+// ---- filter plumbing ------------------------------------------------------
+
+static int ivtc_config_input(AVFilterLink *inlink)
+{
+    FilterLink          *l = ff_filter_link(inlink);
+    AVFilterContext *avctx = inlink->dst;
+    IvtcCUDAContext   *ctx = avctx->priv;
+
+    if (!l->hw_frames_ctx) {
+        av_log(avctx, AV_LOG_ERROR, "ivtc_cuda requires a CUDA hardware frames "
+               "context on the input (decode with -hwaccel_output_format cuda, "
+               "or insert hwupload_cuda).\n");
+        return AVERROR(EINVAL);
+    }
+
+    av_buffer_unref(&ctx->input_frames_ref);
+    ctx->input_frames_ref = av_buffer_ref(l->hw_frames_ctx);
+    if (!ctx->input_frames_ref)
+        return AVERROR(ENOMEM);
+    ctx->input_frames = (AVHWFramesContext*)ctx->input_frames_ref->data;
+    if (ctx->input_frames->format != AV_PIX_FMT_CUDA)
+        return AVERROR(EINVAL);
+
+    av_log(avctx, AV_LOG_INFO, "ivtc_cuda: %dx%d sw_format %s.\n",
+           inlink->w, inlink->h, av_get_pix_fmt_name(ctx->input_frames->sw_format));
+    return 0;
+}
+
+static int ivtc_config_output(AVFilterLink *outlink)
+{
+    FilterLink           *l = ff_filter_link(outlink);
+    AVFilterContext  *avctx = outlink->src;
+    AVFilterLink    *inlink = avctx->inputs[0];
+    IvtcCUDAContext    *ctx = avctx->priv;
+    enum AVPixelFormat sw_format;
+    const AVPixFmtDescriptor *desc;
+    AVHWFramesContext *output_frames;
+    int linesizes[4], ret, i;
+
+    av_assert0(ctx->input_frames);
+    sw_format = ctx->input_frames->sw_format;
+    for (i = 0; i < FF_ARRAY_ELEMS(supported_formats); i++)
+        if (supported_formats[i] == sw_format)
+            break;
+    if (i == FF_ARRAY_ELEMS(supported_formats)) {
+        av_log(avctx, AV_LOG_ERROR, "Unsupported input sw_format: %s.\n",
+               av_get_pix_fmt_name(sw_format));
+        return AVERROR(ENOSYS);
+    }
+
+    // per-plane geometry for the field weave, luma sample size/scale for the kernels
+    desc = av_pix_fmt_desc_get(sw_format);
+    if ((ret = av_image_fill_linesizes(linesizes, sw_format, inlink->w)) < 0)
+        return ret;
+    ctx->nb_planes = av_pix_fmt_count_planes(sw_format);
+    for (i = 0; i < ctx->nb_planes; i++) {
+        ctx->plane_bytes[i] = linesizes[i];
+        ctx->plane_h[i]     = i ? AV_CEIL_RSHIFT(inlink->h, desc->log2_chroma_h) : inlink->h;
+    }
+    ctx->pixel_size = (desc->comp[0].depth + desc->comp[0].shift + 7) / 8;
+    {
+        // the kernels see the whole container value, as the OpenCL UNORM read does
+        double maxval = (double)((1 << (desc->comp[0].depth + desc->comp[0].shift)) - 1);
+        ctx->scale_fm   = (float)(255.0 / maxval);
+        ctx->scale_diff = (float)(1.0 / maxval);
+    }
+
+    av_buffer_unref(&ctx->device_ref);
+    ctx->device_ref = av_buffer_ref(ctx->input_frames->device_ref);
+    if (!ctx->device_ref)
+        return AVERROR(ENOMEM);
+    ctx->hwctx = ((AVHWDeviceContext*)ctx->device_ref->data)->hwctx;
+
+    // own output pool (same device / sw_format), so the woven frames can go
+    // straight to NVENC or further CUDA filters
+    av_buffer_unref(&l->hw_frames_ctx);
+    l->hw_frames_ctx = av_hwframe_ctx_alloc(ctx->device_ref);
+    if (!l->hw_frames_ctx)
+        return AVERROR(ENOMEM);
+    output_frames = (AVHWFramesContext*)l->hw_frames_ctx->data;
+    output_frames->format    = AV_PIX_FMT_CUDA;
+    output_frames->sw_format = sw_format;
+    output_frames->width     = inlink->w;
+    output_frames->height    = inlink->h;
+    output_frames->initial_pool_size = 4;
+
+    if ((ret = ff_filter_init_hw_frames(avctx, outlink, 10)) < 0)
+        return ret;
+    if ((ret = av_hwframe_ctx_init(l->hw_frames_ctx)) < 0) {
+        av_log(avctx, AV_LOG_ERROR, "Failed to initialise CUDA frame "
+               "context for output: %d\n", ret);
+        return ret;
+    }
+
+    outlink->w = inlink->w;
+    outlink->h = inlink->h;
+    return ff_ivtc_config_output_common(outlink);
+}
+
+static int ivtc_init(AVFilterContext *avctx)
+{
+    IvtcCUDAContext *ctx = avctx->priv;
+    IVTCContext *s = &ctx->ivtc;
+
+    ff_ivtc_init_common(avctx);
+    s->init        = ivtc_init_cuda;
+    s->match_accum = ivtc_cuda_match_accum;
+    s->synth       = ivtc_cuda_synth;
+    s->diff_cycle  = ivtc_cuda_diff_cycle;
+    s->sync        = ivtc_cuda_sync;
+    return 0;
+}
+
+static av_cold void ivtc_uninit(AVFilterContext *avctx)
+{
+    IvtcCUDAContext *ctx = avctx->priv;
+
+    ff_ivtc_uninit_common(avctx);
+
+    if (ctx->hwctx) {
+        CudaFunctions *cu = ctx->hwctx->internal->cuda_dl;
+        CUcontext dummy;
+        if (CHECK_CU(cu->cuCtxPushCurrent(ctx->hwctx->cuda_ctx)) >= 0) {
+            if (ctx->absdiff_buf) CHECK_CU(cu->cuMemFree(ctx->absdiff_buf));
+            if (ctx->flag_buf)    CHECK_CU(cu->cuMemFree(ctx->flag_buf));
+            if (ctx->cmp_buf)     CHECK_CU(cu->cuMemFree(ctx->cmp_buf));
+            if (ctx->diff_buf)    CHECK_CU(cu->cuMemFree(ctx->diff_buf));
+            if (ctx->cu_module)   CHECK_CU(cu->cuModuleUnload(ctx->cu_module));
+            CHECK_CU(cu->cuCtxPopCurrent(&dummy));
+        }
+    }
+    av_freep(&ctx->cmp_host);
+    av_freep(&ctx->diff_host);
+
+    av_buffer_unref(&ctx->device_ref);
+    ctx->hwctx = NULL;
+    av_buffer_unref(&ctx->input_frames_ref);
+    ctx->input_frames = NULL;
+}
+
+static const AVOption ivtc_cuda_options[] = {
+    IVTC_COMMON_OPTIONS
+    { NULL }
+};
+
+AVFILTER_DEFINE_CLASS(ivtc_cuda);
+
+static const AVFilterPad ivtc_cuda_inputs[] = {
