+/*
+ * CUDA port of the live field-matching / decimation kernels in
+ * opencl/ivtc.cl. Frames are pitched linear luma planes (uchar or ushort,
+ * pitch in elements); the host passes `scale` so that raw * scale gives the
+ * same value as the OpenCL read_imagef path: 0..255 luma units for the
+ * fieldmatch kernels, 0..1 for the decimation diff. Reads clamp to the plane
+ * edge like the OpenCL sampler. Field-match synthesis needs no kernel: the
+ * host weaves the fields with pitched 2D copies.
+ */
+
+#define IVTC_WG 16
+#define IVTC_NT (IVTC_WG * IVTC_WG)
+
+template<typename T>
+__inline__ __device__ float ivtc_px(const T *p, int pitch, int width, int height,
+                                    int x, int y, float scale)
+{
+    x = min(max(x, 0), width - 1);
+    y = min(max(y, 0), height - 1);
+    return (float)p[y * pitch + x] * scale;
+}
+
+/* =====================================================================
+ * vf_fieldmatch compare_fields port (Stage 1: C-vs-P primary match).
+ *
+ * Ported from libavfilter/vf_fieldmatch.c (build_abs_diff_mask,
+ * build_diff_map, compare_fields). Works in 0..255 luma units so
+ * fieldmatch's integer thresholds (3,19,23,42) apply unchanged. TFF (tff=1):
+ * keep top/even field, evaluate/borrow the bottom/odd field; BFF mirrors.
+ * "field rows" index the borrowed parity: borrowed image row yb = 2*fy + (tff?1:0).
+ * ===================================================================== */
+
+// |cur.borrowed - cand.borrowed| per borrowed field row -> D[fy*width + x] (0..255)
+template<typename T>
+__inline__ __device__ void fm_absdiff(const T *cur, const T *cand,
+                                      int cur_pitch, int cand_pitch,
+                                      int width, int height, int hf, int tff,
+                                      float scale, unsigned char *D)
+{
+    int x  = blockIdx.x * blockDim.x + threadIdx.x;
+    int fy = blockIdx.y * blockDim.y + threadIdx.y;
+    if (x >= width || fy >= hf)
+        return;
+    int yb = 2 * fy + (tff ? 1 : 0);
+    float d = fabsf(ivtc_px(cur,  cur_pitch,  width, height, x, yb, scale) -
+                    ivtc_px(cand, cand_pitch, width, height, x, yb, scale));
+    D[fy * width + x] = (unsigned char)(d > 255.0f ? 255 : (int)(d + 0.5f));
+}
+
+// compare_fields accumulation for match1=C (cur) vs match2=cand. Each block writes
+// 6 partials: {Ac,Am,Aml, Bc,Bm,Bml} -> out[blk*6 + 0..5]; host sums + decides.
+template<typename T>
+__inline__ __device__ void fm_compare_accum(const T *cur, const T *cand,
+                                            int cur_pitch, int cand_pitch,
+                                            int width, int height, int tff,
+                                            const unsigned char *F, int hf,
+                                            float scale, int nbx, float *out)
+{
+    __shared__ float l[IVTC_NT * 6];
+    int x   = blockIdx.x * blockDim.x + threadIdx.x;
+    int y   = blockIdx.y * blockDim.y + threadIdx.y;
+    int tid = threadIdx.y * IVTC_WG + threadIdx.x;
+    int kp  = tff ? 0 : 1;             // kept parity
+    int bf  = tff ? 1 : 0;             // borrowed parity
+
+    float Ac = 0, Am = 0, Aml = 0, Bc = 0, Bm = 0, Bml = 0;
+    if (x >= 8 && x < width - 8 && (y & 1) == kp && y >= 2 && y < height - 2) {
+        float t1 = ivtc_px(cur, cur_pitch, width, height, x, y - 2, scale) +
+                   4.0f * ivtc_px(cur, cur_pitch, width, height, x, y, scale) +
+                   ivtc_px(cur, cur_pitch, width, height, x, y + 2, scale);
+        float a  = fabsf(3.0f * (ivtc_px(cur, cur_pitch, width, height, x, y - 1, scale) +
+                                 ivtc_px(cur, cur_pitch, width, height, x, y + 1, scale)) - t1);
+        float b  = fabsf(3.0f * (ivtc_px(cand, cand_pitch, width, height, x, y - 1, scale) +
+                                 ivtc_px(cand, cand_pitch, width, height, x, y + 1, scale)) - t1);
+        // mask flags at the two borrowed field rows adjacent to kept row y
+        int fa = (y - 1 - bf) >> 1, fb = (y + 1 - bf) >> 1;
+        int m = 0;
+        if (fa >= 0 && fa < hf) m |= F[fa * width + x];
+        if (fb >= 0 && fb < hf) m |= F[fb * width + x];
+        if (a > 23.0f && (m & 1)) Ac += a;
+        if (a > 42.0f) { if (m & 2) Am += a; if (m & 4) Aml += a; }
+        if (b > 23.0f && (m & 1)) Bc += b;
+        if (b > 42.0f) { if (m & 2) Bm += b; if (m & 4) Bml += b; }
+    }
+
+    // planar layout l[k*NT + tid] (avoids stride-6 bank conflicts)
+    l[0*IVTC_NT+tid]=Ac; l[1*IVTC_NT+tid]=Am; l[2*IVTC_NT+tid]=Aml;
+    l[3*IVTC_NT+tid]=Bc; l[4*IVTC_NT+tid]=Bm; l[5*IVTC_NT+tid]=Bml;
+    __syncthreads();
+    for (int s = IVTC_NT / 2; s > 0; s >>= 1) {
+        if (tid < s)
+            for (int k = 0; k < 6; k++)
+                l[k*IVTC_NT+tid] += l[k*IVTC_NT+tid+s];
+        __syncthreads();
+    }
+    if (tid == 0) {
+        int blk = blockIdx.y * nbx + blockIdx.x;
+        for (int k = 0; k < 6; k++)
+            out[blk*6+k] = l[k*IVTC_NT];
+    }
+}
+
+/*
+ * Luma SAD between two frames for decimation duplicate detection. Each block
+ * writes its partial sum to diffs[blk]; the host reduces the block grid.
+ */
+template<typename T>
+__inline__ __device__ void ivtc_diff(const T *a, const T *b, int a_pitch, int b_pitch,
+                                     int width, int height, float scale,
+                                     int nbx, float *diffs)
+{
+    __shared__ float l[IVTC_NT];
+    int x   = blockIdx.x * blockDim.x + threadIdx.x;
+    int y   = blockIdx.y * blockDim.y + threadIdx.y;
+    int tid = threadIdx.y * IVTC_WG + threadIdx.x;
+
+    float d = 0.0f;
+    if (x < width && y < height)
+        d = fabsf(ivtc_px(a, a_pitch, width, height, x, y, scale) -
+                  ivtc_px(b, b_pitch, width, height, x, y, scale));
+
+    l[tid] = d;
+    __syncthreads();
+    for (int s = IVTC_NT / 2; s > 0; s >>= 1) {
+        if (tid < s) l[tid] += l[tid + s];
+        __syncthreads();
+    }
+    if (tid == 0)
+        diffs[blockIdx.y * nbx + blockIdx.x] = l[0];
+}
+
+extern "C" {
+
+// build_diff_map: flag bits 1/2/4 per field-row diff magnitude + clustering.
+__global__ void fm_diffmap(const unsigned char *D, int width, int hf,
+                           unsigned char *F)
+{
+    int x  = blockIdx.x * blockDim.x + threadIdx.x;
+    int fy = blockIdx.y * blockDim.y + threadIdx.y;
+    if (x >= width || fy >= hf)
+        return;
+    F[fy * width + x] = 0;
+    if (fy < 1 || fy >= hf - 1 || x < 1 || x >= width - 1)
+        return;
+    int diff = D[fy * width + x];
+    if (diff <= 3)
+        return;
+    int u, count = 0;
+    for (u = x - 1; u < x + 2 && count < 2; u++) {
+        count += D[(fy - 1) * width + u] > 3;
+        count += D[ fy      * width + u] > 3;
+        count += D[(fy + 1) * width + u] > 3;
+    }
+    if (count <= 1)
+        return;
+    unsigned char f = 1;
+    if (diff > 19) {
+        int upper = 0, lower = 0;
+        count = 0;
+        for (u = x - 1; u < x + 2 && count < 6; u++) {
+            if (D[(fy - 1) * width + u] > 19) { count++; upper = 1; }
+            if (D[ fy      * width + u] > 19)   count++;
+            if (D[(fy + 1) * width + u] > 19) { count++; lower = 1; }
+        }
+        if (count > 3) {
+            if (upper && lower) {
+                f |= 1 << 1;
+            } else {
+                int upper2 = 0, lower2 = 0;
+                int ulo = max(x - 4, 0), uhi = min(x + 5, width);
+                for (u = ulo; u < uhi; u++) {
+                    if (fy >= 2      && D[(fy - 2) * width + u] > 19) upper2 = 1;
+                    if (                D[(fy - 1) * width + u] > 19) upper  = 1;
+                    if (                D[(fy + 1) * width + u] > 19) lower  = 1;
+                    if (fy < hf - 2  && D[(fy + 2) * width + u] > 19) lower2 = 1;
+                }
+                if ((upper && (lower || upper2)) || (lower && (upper || lower2)))
+                    f |= 1 << 1;
+                else if (count > 5)
+                    f |= 1 << 2;
+            }
+        }
+    }
+    F[fy * width + x] = f;
+}
+
+#define IVTC_VARIANT(T, name)                                                          \
+__global__ void fm_absdiff_##name(const T *cur, const T *cand,                         \
+                                  int cur_pitch, int cand_pitch,                       \
+                                  int width, int height, int hf, int tff,              \
+                                  float scale, unsigned char *D)                       \
+{                                                                                      \
+    fm_absdiff<T>(cur, cand, cur_pitch, cand_pitch, width, height, hf, tff,           \
+                  scale, D);                                                           \
+}                                                                                      \
+__global__ void fm_compare_accum_##name(const T *cur, const T *cand,                   \
+                                        int cur_pitch, int cand_pitch,                 \
+                                        int width, int height, int tff,                \
+                                        const unsigned char *F, int hf,                \
+                                        float scale, int nbx, float *out)              \
+{                                                                                      \
+    fm_compare_accum<T>(cur, cand, cur_pitch, cand_pitch, width, height, tff,         \
+                        F, hf, scale, nbx, out);                                       \
+}                                                                                      \
+__global__ void ivtc_diff_##name(const T *a, const T *b, int a_pitch, int b_pitch,     \
+                                 int width, int height, float scale,                   \
+                                 int nbx, float *diffs)                                \
+{                                                                                      \
+    ivtc_diff<T>(a, b, a_pitch, b_pitch, width, height, scale, nbx, diffs);           \
+}
+
+IVTC_VARIANT(unsigned char,  uchar)
+IVTC_VARIANT(unsigned short, ushort)
+
+}
