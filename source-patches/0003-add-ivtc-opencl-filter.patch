+/*
+ * Field-matching IVTC kernels (Phase 2), ported from QSVEnc rgy_filter_ivtc.cl
+ * to ffmpeg's AV_PIX_FMT_OPENCL image2d_t model. Pixels are normalized floats
+ * (0..1), so the algorithm is bit-depth agnostic and edge clamping is handled by
+ * the sampler.
+ *
+ * Candidate field-match geometry (TFF: first field = top = even rows). The full
+ * {mC, mP, mN, mB, mU} set vf_fieldmatch can use: mP/mN keep cur's first (top)
+ * field and borrow the second (bottom) from prev/next; mB/mU keep cur's second
+ * (bottom) field and borrow the first (top) from prev/next. Both keep-parities
+ * are needed because in 3:2 pulldown the "foreign" field alternates top/bottom
+ * by cadence phase -- offering only keep-top candidates locks the recovered
+ * duplicate to the wrong cycle slot:
+ *   C: [cur.top, cur.bot ]   current frame as-is              (fieldmatch mC)
+ *   P: [cur.top, prev.bot]   keep top, borrow bottom from prev (fieldmatch mP)
+ *   N: [cur.top, next.bot]   keep top, borrow bottom from next (fieldmatch mN)
+ *   B: [prev.top, cur.bot]   keep bottom, borrow top from prev (fieldmatch mB)
+ *   U: [next.top, cur.bot]   keep bottom, borrow top from next (fieldmatch mU)
+ */
+
+#define IVTC_WG 16
+#define IVTC_NCAND 5
+
+__constant sampler_t ivtc_samp = (CLK_NORMALIZED_COORDS_FALSE |
+                                  CLK_ADDRESS_CLAMP_TO_EDGE   |
+                                  CLK_FILTER_NEAREST);
+
+// One luma sample under candidate `match` (0=C,1=P,2=N,3=B,4=U) at (x,y).
+static float ivtc_cand(__read_only image2d_t prev,
+                       __read_only image2d_t cur,
+                       __read_only image2d_t next,
+                       int x, int y, int tff, int match)
+{
+    int first = ((y & 1) == (tff ? 0 : 1));   // first-field (top) row?
+    int2 p = (int2)(x, y);
+    // NB: OpenCL forbids selecting an image2d_t with ?: -- branch on the float result.
+    switch (match) {
+    case 1: return first ? read_imagef(cur,  ivtc_samp, p).x : read_imagef(prev, ivtc_samp, p).x; // P
+    case 2: return first ? read_imagef(cur,  ivtc_samp, p).x : read_imagef(next, ivtc_samp, p).x; // N
+    case 3: return first ? read_imagef(prev, ivtc_samp, p).x : read_imagef(cur,  ivtc_samp, p).x; // B
+    case 4: return first ? read_imagef(next, ivtc_samp, p).x : read_imagef(cur,  ivtc_samp, p).x; // U
+    default: return read_imagef(cur, ivtc_samp, p).x;                                             // C
+    }
+}
+
+/*
+ * Score C/P/N combing on the luma plane as a motion-masked combing *energy*
+ * (not a binary combed-pixel count). For a second-field row that is a same-sign
+ * vertical extremum between its two preserved-parity neighbours, the combing
+ * strength is the SMALLER of the two excursions, min(|d0|,|d2|): a real comb
+ * spikes both sides, while an edge/gradient leaves one side ~0 and is therefore
+ * masked out (the `lo > thresh` gate). Accumulating that graded energy -- rather
+ * than counting pixels over a threshold -- separates near-tie candidates on
+ * limited-animation frames, where a binary count is dominated by noise and makes
+ * the per-frame match flip (breaking the decimation cadence). This mirrors the
+ * spirit of vf_fieldmatch's motion-masked metric while staying a single-pass GPU
+ * reduction. Each work-group writes IVTC_NCAND partial energies to
+ * scores[wg*IVTC_NCAND + m]; the host sums across work-groups and picks the
+ * lowest-energy candidate.
+ */
+// args: 0=prev 1=cur 2=next 3=width 4=height 5=tff 6=thresh 7=scores
+__attribute__((reqd_work_group_size(IVTC_WG, IVTC_WG, 1)))
+__kernel void ivtc_score(__read_only image2d_t prev,
+                         __read_only image2d_t cur,
+                         __read_only image2d_t next,
+                         int width, int height, int tff, float thresh,
+                         __global float *scores)
+{
+    int x   = get_global_id(0);
+    int y   = get_global_id(1);
+    int tid = get_local_id(1) * IVTC_WG + get_local_id(0);
+    int first_parity = tff ? 0 : 1;
+    int m;
+
+    float e[IVTC_NCAND];
+    for (m = 0; m < IVTC_NCAND; m++) e[m] = 0.0f;
+    if (x < width && (y & 1) == first_parity && (y + 2) < height) {
+        for (m = 0; m < IVTC_NCAND; m++) {
+            float v0 = ivtc_cand(prev, cur, next, x, y,     tff, m);
+            float v1 = ivtc_cand(prev, cur, next, x, y + 1, tff, m);
+            float v2 = ivtc_cand(prev, cur, next, x, y + 2, tff, m);
+            float d0 = v1 - v0, d2 = v1 - v2;
+            if ((d0 < 0.0f) == (d2 < 0.0f)) {           // same-sign extremum
+                float lo = fmin(fabs(d0), fabs(d2));    // combing strength
+                if (lo > thresh)                        // motion/comb gate
+                    e[m] = lo;
+            }
+        }
+    }
+
+    __local float l[IVTC_WG * IVTC_WG * IVTC_NCAND];
+    for (m = 0; m < IVTC_NCAND; m++) l[tid * IVTC_NCAND + m] = e[m];
+    barrier(CLK_LOCAL_MEM_FENCE);
+    for (int s = (IVTC_WG * IVTC_WG) / 2; s > 0; s >>= 1) {
+        if (tid < s)
+            for (m = 0; m < IVTC_NCAND; m++)
+                l[tid * IVTC_NCAND + m] += l[(tid + s) * IVTC_NCAND + m];
+        barrier(CLK_LOCAL_MEM_FENCE);
+    }
+    if (tid == 0) {
+        int wg = get_group_id(1) * get_num_groups(0) + get_group_id(0);
+        for (m = 0; m < IVTC_NCAND; m++)
+            scores[wg * IVTC_NCAND + m] = l[m];
+    }
+}
+
+/*
+ * Synthesize the chosen field-match into dst. Works for any plane (luma R, or
+ * chroma RG) since it copies whole float4 samples per the candidate scheme.
+ */
+// args: 0=dst 1=prev 2=cur 3=next 4=tff 5=match
+__kernel void ivtc_synthesize(__write_only image2d_t dst,
+                              __read_only  image2d_t prev,
+                              __read_only  image2d_t cur,
+                              __read_only  image2d_t next,
+                              int tff, int match)
+{
+    int2 pos = (int2)(get_global_id(0), get_global_id(1));
+    if (pos.x >= get_image_width(dst) || pos.y >= get_image_height(dst))
+        return;
+    int first = ((pos.y & 1) == (tff ? 0 : 1));
+    float4 v;
+    switch (match) {
+    case 1: v = first ? read_imagef(cur,  ivtc_samp, pos) : read_imagef(prev, ivtc_samp, pos); break; // P
+    case 2: v = first ? read_imagef(cur,  ivtc_samp, pos) : read_imagef(next, ivtc_samp, pos); break; // N
+    case 3: v = first ? read_imagef(prev, ivtc_samp, pos) : read_imagef(cur,  ivtc_samp, pos); break; // B
+    case 4: v = first ? read_imagef(next, ivtc_samp, pos) : read_imagef(cur,  ivtc_samp, pos); break; // U
+    default: v = read_imagef(cur, ivtc_samp, pos); break;                                             // C
+    }
+    write_imagef(dst, pos, v);
+}
+
+/*
+ * Luma SAD between two frames for decimation duplicate detection. Each
+ * work-group writes its partial sum to diffs[wg]; the host sums them.
+ */
+// args: 0=a 1=b 2=width 3=height 4=diffs
+__attribute__((reqd_work_group_size(IVTC_WG, IVTC_WG, 1)))
+__kernel void ivtc_diff(__read_only image2d_t a,
+                        __read_only image2d_t b,
+                        int width, int height,
+                        __global float *diffs)
+{
+    int x   = get_global_id(0);
+    int y   = get_global_id(1);
+    int tid = get_local_id(1) * IVTC_WG + get_local_id(0);
+
+    float d = 0.0f;
+    if (x < width && y < height)
+        d = fabs(read_imagef(a, ivtc_samp, (int2)(x, y)).x -
+                 read_imagef(b, ivtc_samp, (int2)(x, y)).x);
+
+    __local float l[IVTC_WG * IVTC_WG];
+    l[tid] = d;
+    barrier(CLK_LOCAL_MEM_FENCE);
+    for (int s = (IVTC_WG * IVTC_WG) / 2; s > 0; s >>= 1) {
+        if (tid < s) l[tid] += l[tid + s];
+        barrier(CLK_LOCAL_MEM_FENCE);
+    }
+    if (tid == 0) {
+        int wg = get_group_id(1) * get_num_groups(0) + get_group_id(0);
+        diffs[wg] = l[0];
+    }
+}
+
+/* =====================================================================
+ * vf_fieldmatch compare_fields port (Stage 1: C-vs-P primary match).
+ *
+ * Ported from libavfilter/vf_fieldmatch.c (build_abs_diff_mask,
+ * build_diff_map, compare_fields). Works in 0..255 luma units (read_imagef
+ * gives 0..1 for 8-bit, *255) so fieldmatch's integer thresholds (3,19,23,42)
+ * apply unchanged. TFF (tff=1): keep top/even field, evaluate/borrow the
+ * bottom/odd field; BFF mirrors. "field rows" index the borrowed parity:
+ * borrowed image row yb = 2*fy + (tff?1:0).
+ * ===================================================================== */
+
+static float fm_luma(__read_only image2d_t im, int x, int y)
+{
+    return read_imagef(im, ivtc_samp, (int2)(x, y)).x * 255.0f;
+}
+
+// |cur.borrowed - cand.borrowed| per borrowed field row -> D[fy*width + x] (0..255)
+// args: 0=cur 1=cand 2=width 3=hf 4=tff 5=D
+__kernel void fm_absdiff(__read_only image2d_t cur,
+                         __read_only image2d_t cand,
+                         int width, int hf, int tff, __global uchar *D)
+{
+    int x  = get_global_id(0);
+    int fy = get_global_id(1);
+    if (x >= width || fy >= hf)
+        return;
+    int yb = 2 * fy + (tff ? 1 : 0);
+    float d = fabs(fm_luma(cur, x, yb) - fm_luma(cand, x, yb));
+    D[fy * width + x] = (uchar)(d > 255.0f ? 255 : (int)(d + 0.5f));
+}
+
+// build_diff_map: flag bits 1/2/4 per field-row diff magnitude + clustering.
+// args: 0=D 1=width 2=hf 3=F
+__kernel void fm_diffmap(__global const uchar *D, int width, int hf,
+                         __global uchar *F)
+{
+    int x  = get_global_id(0);
+    int fy = get_global_id(1);
+    if (x >= width || fy >= hf)
+        return;
+    F[fy * width + x] = 0;
+    if (fy < 1 || fy >= hf - 1 || x < 1 || x >= width - 1)
+        return;
+    int diff = D[fy * width + x];
+    if (diff <= 3)
+        return;
+    int u, count = 0;
+    for (u = x - 1; u < x + 2 && count < 2; u++) {
+        count += D[(fy - 1) * width + u] > 3;
+        count += D[ fy      * width + u] > 3;
+        count += D[(fy + 1) * width + u] > 3;
+    }
+    if (count <= 1)
+        return;
+    uchar f = 1;
+    if (diff > 19) {
+        int upper = 0, lower = 0;
+        count = 0;
+        for (u = x - 1; u < x + 2 && count < 6; u++) {
+            if (D[(fy - 1) * width + u] > 19) { count++; upper = 1; }
+            if (D[ fy      * width + u] > 19)   count++;
+            if (D[(fy + 1) * width + u] > 19) { count++; lower = 1; }
+        }
+        if (count > 3) {
+            if (upper && lower) {
+                f |= 1 << 1;
+            } else {
+                int upper2 = 0, lower2 = 0;
+                int ulo = max(x - 4, 0), uhi = min(x + 5, width);
+                for (u = ulo; u < uhi; u++) {
+                    if (fy >= 2      && D[(fy - 2) * width + u] > 19) upper2 = 1;
+                    if (                D[(fy - 1) * width + u] > 19) upper  = 1;
+                    if (                D[(fy + 1) * width + u] > 19) lower  = 1;
+                    if (fy < hf - 2  && D[(fy + 2) * width + u] > 19) lower2 = 1;
+                }
+                if ((upper && (lower || upper2)) || (lower && (upper || lower2)))
+                    f |= 1 << 1;
+                else if (count > 5)
+                    f |= 1 << 2;
+            }
+        }
+    }
+    F[fy * width + x] = f;
+}
+
+// compare_fields accumulation for match1=C (cur) vs match2=cand. Each WG writes
+// 6 partials: {Ac,Am,Aml, Bc,Bm,Bml} -> out[wg*6 + 0..5]; host sums + decides.
+// args: 0=cur 1=cand 2=width 3=height 4=tff 5=F 6=hf 7=out
+__attribute__((reqd_work_group_size(IVTC_WG, IVTC_WG, 1)))
+__kernel void fm_compare_accum(__read_only image2d_t cur,
+                               __read_only image2d_t cand,
+                               int width, int height, int tff,
+                               __global const uchar *F, int hf,
+                               __global float *out)
+{
+    int x   = get_global_id(0);
+    int y   = get_global_id(1);
+    int tid = get_local_id(1) * IVTC_WG + get_local_id(0);
+    int kp  = tff ? 0 : 1;             // kept parity
+    int bf  = tff ? 1 : 0;             // borrowed parity
+
+    float Ac = 0, Am = 0, Aml = 0, Bc = 0, Bm = 0, Bml = 0;
+    if (x >= 8 && x < width - 8 && (y & 1) == kp && y >= 2 && y < height - 2) {
+        float t1 = fm_luma(cur, x, y - 2) + 4.0f * fm_luma(cur, x, y) + fm_luma(cur, x, y + 2);
+        float a  = fabs(3.0f * (fm_luma(cur,  x, y - 1) + fm_luma(cur,  x, y + 1)) - t1);
+        float b  = fabs(3.0f * (fm_luma(cand, x, y - 1) + fm_luma(cand, x, y + 1)) - t1);
+        // mask flags at the two borrowed field rows adjacent to kept row y
+        int fa = (y - 1 - bf) >> 1, fb = (y + 1 - bf) >> 1;
+        int m = 0;
+        if (fa >= 0 && fa < hf) m |= F[fa * width + x];
+        if (fb >= 0 && fb < hf) m |= F[fb * width + x];
+        if (a > 23.0f && (m & 1)) Ac += a;
+        if (a > 42.0f) { if (m & 2) Am += a; if (m & 4) Aml += a; }
+        if (b > 23.0f && (m & 1)) Bc += b;
+        if (b > 42.0f) { if (m & 2) Bm += b; if (m & 4) Bml += b; }
+    }
+
+    __local float l[IVTC_WG * IVTC_WG * 6];
+    // planar layout l[k*NT + tid] (avoids stride-6 bank conflicts)
+    const int NT = IVTC_WG * IVTC_WG;
+    l[0*NT+tid]=Ac; l[1*NT+tid]=Am; l[2*NT+tid]=Aml;
+    l[3*NT+tid]=Bc; l[4*NT+tid]=Bm; l[5*NT+tid]=Bml;
+    barrier(CLK_LOCAL_MEM_FENCE);
+    for (int s = (IVTC_WG * IVTC_WG) / 2; s > 0; s >>= 1) {
+        if (tid < s)
+            for (int k = 0; k < 6; k++)
+                l[k*NT+tid] += l[k*NT+tid+s];
+        barrier(CLK_LOCAL_MEM_FENCE);
+    }
+    if (tid == 0) {
+        int wg = get_group_id(1) * get_num_groups(0) + get_group_id(0);
+        for (int k = 0; k < 6; k++)
+            out[wg*6+k] = l[k*NT];
+    }
+}
