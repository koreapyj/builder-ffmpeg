+/*
+ * D3D11 compute port of the field-matching / decimation kernels in
+ * vf_ivtc_cuda.cu. Planes are UNORM views (R8/R8G8 for NV12, R16/R16G16 for
+ * P010); every analysis read is rounded back to the raw container integer and
+ * multiplied by `scale`, so the values match the CUDA path (raw * scale):
+ * 0..255 luma units for the fieldmatch kernels, 0..1 for the decimation diff.
+ * Reads clamp to the plane edge like the CUDA/OpenCL kernels. The weave
+ * kernels copy whole fields and need no rounding.
+ */
+
+#define IVTC_WG 16
+#define IVTC_NT (IVTC_WG * IVTC_WG)
+
+// luma planes: cur/a (t0) and cand/b (t1); chroma planes for the weave
+Texture2DArray<float>  tex_a_y  : register(t0);
+Texture2DArray<float>  tex_b_y  : register(t1);
+Texture2DArray<float2> tex_a_uv : register(t2);
+Texture2DArray<float2> tex_b_uv : register(t3);
+
+RWStructuredBuffer<uint>  D_buf    : register(u0); // |cur-cand| per borrowed field row (w*hf)
+RWStructuredBuffer<uint>  F_buf    : register(u1); // build_diff_map flags (w*hf)
+RWStructuredBuffer<float> cmp_buf  : register(u2); // per-block compare_fields partials (nwg*6)
+RWStructuredBuffer<float> diff_buf : register(u3); // per-block luma SAD (IVTC_CYCLE slices of nwg)
+RWTexture2DArray<float>   dst_y    : register(u4);
+RWTexture2DArray<float2>  dst_uv   : register(u5);
+
+cbuffer Params : register(b0) {
+    int   width;
+    int   height;
+    int   hf;
+    int   tff;
+    int   nbx;
+    int   out_offset;   // ivtc_diff: slice offset into diff_buf
+    int   first;        // weave: parity of the rows taken from tex_a
+    int   pad0;
+    float scale;
+    float maxval;       // UNORM -> raw container integer
+    float pad1;
+    float pad2;
+};
+
+groupshared float l[IVTC_NT * 6];
+
+float px_a(int x, int y)
+{
+    x = min(max(x, 0), width - 1);
+    y = min(max(y, 0), height - 1);
+    return round(tex_a_y.Load(int4(x, y, 0, 0)) * maxval) * scale;
+}
+
+float px_b(int x, int y)
+{
+    x = min(max(x, 0), width - 1);
+    y = min(max(y, 0), height - 1);
+    return round(tex_b_y.Load(int4(x, y, 0, 0)) * maxval) * scale;
+}
+
+/* =====================================================================
+ * vf_fieldmatch compare_fields port (Stage 1: C-vs-P primary match).
+ * See vf_ivtc_cuda.cu: works in 0..255 luma units so fieldmatch's integer
+ * thresholds (3,19,23,42) apply unchanged; "field rows" index the borrowed
+ * parity: borrowed image row yb = 2*fy + (tff?1:0).
+ * ===================================================================== */
+
+// |cur.borrowed - cand.borrowed| per borrowed field row -> D[fy*width + x] (0..255)
+[numthreads(IVTC_WG, IVTC_WG, 1)]
+void fm_absdiff(uint3 id : SV_DispatchThreadID)
+{
+    int x  = id.x;
+    int fy = id.y;
+    if (x >= width || fy >= hf)
+        return;
+    int yb = 2 * fy + (tff ? 1 : 0);
+    float d = abs(px_a(x, yb) - px_b(x, yb));
+    D_buf[fy * width + x] = d > 255.0f ? 255 : (uint)(int)(d + 0.5f);
+}
+
+// build_diff_map: flag bits 1/2/4 per field-row diff magnitude + clustering.
+[numthreads(IVTC_WG, IVTC_WG, 1)]
+void fm_diffmap(uint3 id : SV_DispatchThreadID)
+{
+    int x  = id.x;
+    int fy = id.y;
+    int u, count;
+    if (x >= width || fy >= hf)
+        return;
+    F_buf[fy * width + x] = 0;
+    if (fy < 1 || fy >= hf - 1 || x < 1 || x >= width - 1)
+        return;
+    int diff = D_buf[fy * width + x];
+    if (diff <= 3)
+        return;
+    count = 0;
+    for (u = x - 1; u < x + 2 && count < 2; u++) {
+        count += D_buf[(fy - 1) * width + u] > 3;
+        count += D_buf[ fy      * width + u] > 3;
+        count += D_buf[(fy + 1) * width + u] > 3;
+    }
+    if (count <= 1)
+        return;
+    uint f = 1;
+    if (diff > 19) {
+        int upper = 0, lower = 0;
+        count = 0;
+        for (u = x - 1; u < x + 2 && count < 6; u++) {
+            if (D_buf[(fy - 1) * width + u] > 19) { count++; upper = 1; }
+            if (D_buf[ fy      * width + u] > 19)   count++;
+            if (D_buf[(fy + 1) * width + u] > 19) { count++; lower = 1; }
+        }
+        if (count > 3) {
+            if (upper && lower) {
+                f |= 1 << 1;
+            } else {
+                int upper2 = 0, lower2 = 0;
+                int ulo = max(x - 4, 0), uhi = min(x + 5, width);
+                for (u = ulo; u < uhi; u++) {
+                    if (fy >= 2      && D_buf[(fy - 2) * width + u] > 19) upper2 = 1;
+                    if (                D_buf[(fy - 1) * width + u] > 19) upper  = 1;
+                    if (                D_buf[(fy + 1) * width + u] > 19) lower  = 1;
+                    if (fy < hf - 2  && D_buf[(fy + 2) * width + u] > 19) lower2 = 1;
+                }
+                if ((upper && (lower || upper2)) || (lower && (upper || lower2)))
+                    f |= 1 << 1;
+                else if (count > 5)
+                    f |= 1 << 2;
+            }
+        }
+    }
+    F_buf[fy * width + x] = f;
+}
+
+// compare_fields accumulation for match1=C (cur, tex_a) vs match2=cand (tex_b).
+// Each group writes 6 partials: {Ac,Am,Aml, Bc,Bm,Bml} -> cmp_buf[blk*6 + 0..5].
+[numthreads(IVTC_WG, IVTC_WG, 1)]
+void fm_compare_accum(uint3 id : SV_DispatchThreadID, uint3 gid : SV_GroupID,
+                      uint tid : SV_GroupIndex)
+{
+    int x  = id.x;
+    int y  = id.y;
+    int kp = tff ? 0 : 1;              // kept parity
+    int bf = tff ? 1 : 0;              // borrowed parity
+    uint k, s;
+
+    float Ac = 0, Am = 0, Aml = 0, Bc = 0, Bm = 0, Bml = 0;
+    if (x >= 8 && x < width - 8 && (y & 1) == kp && y >= 2 && y < height - 2) {
+        float t1 = px_a(x, y - 2) + 4.0f * px_a(x, y) + px_a(x, y + 2);
+        float a  = abs(3.0f * (px_a(x, y - 1) + px_a(x, y + 1)) - t1);
+        float b  = abs(3.0f * (px_b(x, y - 1) + px_b(x, y + 1)) - t1);
+        // mask flags at the two borrowed field rows adjacent to kept row y
+        int fa = (y - 1 - bf) >> 1, fb = (y + 1 - bf) >> 1;
+        uint m = 0;
+        if (fa >= 0 && fa < hf) m |= F_buf[fa * width + x];
+        if (fb >= 0 && fb < hf) m |= F_buf[fb * width + x];
+        if (a > 23.0f && (m & 1)) Ac += a;
+        if (a > 42.0f) { if (m & 2) Am += a; if (m & 4) Aml += a; }
+        if (b > 23.0f && (m & 1)) Bc += b;
+        if (b > 42.0f) { if (m & 2) Bm += b; if (m & 4) Bml += b; }
+    }
+
+    // planar layout l[k*NT + tid], same tree as the CUDA kernel
+    l[0*IVTC_NT+tid] = Ac; l[1*IVTC_NT+tid] = Am; l[2*IVTC_NT+tid] = Aml;
+    l[3*IVTC_NT+tid] = Bc; l[4*IVTC_NT+tid] = Bm; l[5*IVTC_NT+tid] = Bml;
+    GroupMemoryBarrierWithGroupSync();
+    for (s = IVTC_NT / 2; s > 0; s >>= 1) {
+        if (tid < s)
+            for (k = 0; k < 6; k++)
+                l[k*IVTC_NT+tid] += l[k*IVTC_NT+tid+s];
+        GroupMemoryBarrierWithGroupSync();
+    }
+    if (tid == 0) {
+        uint blk = gid.y * nbx + gid.x;
+        for (k = 0; k < 6; k++)
+            cmp_buf[blk*6+k] = l[k*IVTC_NT];
+    }
+}
+
+/*
+ * Luma SAD between two frames for decimation duplicate detection. Each group
+ * writes its partial sum to diff_buf[out_offset + blk]; the host reduces.
+ */
+[numthreads(IVTC_WG, IVTC_WG, 1)]
+void ivtc_diff(uint3 id : SV_DispatchThreadID, uint3 gid : SV_GroupID,
+               uint tid : SV_GroupIndex)
+{
+    int x = id.x;
+    int y = id.y;
+    uint s;
+
+    float d = 0.0f;
+    if (x < width && y < height)
+        d = abs(px_a(x, y) - px_b(x, y));
+
+    l[tid] = d;
+    GroupMemoryBarrierWithGroupSync();
+    for (s = IVTC_NT / 2; s > 0; s >>= 1) {
+        if (tid < s)
+            l[tid] += l[tid + s];
+        GroupMemoryBarrierWithGroupSync();
+    }
+    if (tid == 0)
+        diff_buf[out_offset + gid.y * nbx + gid.x] = l[0];
+}
+
+/*
+ * Field weave: rows of parity `first` come from tex_a, the others from tex_b
+ * (the CUDA backend does this with pitched 2D copies).
+ */
+[numthreads(IVTC_WG, IVTC_WG, 1)]
+void weave_y(uint3 id : SV_DispatchThreadID)
+{
+    int x = id.x;
+    int y = id.y;
+    if (x >= width || y >= height)
+        return;
+    dst_y[uint3(x, y, 0)] = (y & 1) == first ? tex_a_y.Load(int4(x, y, 0, 0))
+                                             : tex_b_y.Load(int4(x, y, 0, 0));
+}
+
+[numthreads(IVTC_WG, IVTC_WG, 1)]
+void weave_uv(uint3 id : SV_DispatchThreadID)
+{
+    int x = id.x;
+    int y = id.y;
+    if (x >= (width + 1) >> 1 || y >= (height + 1) >> 1)
+        return;
+    dst_uv[uint3(x, y, 0)] = (y & 1) == first ? tex_a_uv.Load(int4(x, y, 0, 0))
+                                              : tex_b_uv.Load(int4(x, y, 0, 0));
+}
